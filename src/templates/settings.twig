{% import '_includes/forms' as forms %}

{# Project config: read-only on prod when allowAdminChanges is off (by design).
   Craft renders this inside settings/plugins/_settings.twig, so a `tabs`
   variable set here never reaches the layout (cp.twig reads tabs from the outer
   template).
   Use headed sections, or override Plugin::getSettingsResponse() with a full
   page template if you truly need tabs.

   The rule for every setting you add: never leave a stored setting out of the
   POST. Craft saves only the posted keys and replaces the whole
   plugins.sorts.settings entry in project config, so a stored setting that
   is not posted is erased on save. Two cases carry the stored value
   (`stored`, from project config) in hidden inputs instead of the field:
   - set in config/sorts.php (`overrides`): show the field disabled with
     the override note, so the file's value is never posted and never lands in
     project config;
   - Pro setting, on Lite: show the field disabled and marked Pro, so a Pro
     value survives a Lite save.
   `carry()` handles scalars and one level of array, which is every setting here. #}

{% macro carry(name, value) -%}
    {%- if value is iterable -%}
        {%- for key, item in value %}{{ hiddenInput(name ~ '[' ~ key ~ ']', item is same as(true) ? '1' : (item is same as(false) ? '' : item)) }}{% endfor -%}
    {%- elseif value is not null -%}
        {{ hiddenInput(name, value is same as(true) ? '1' : (value is same as(false) ? '' : value)) }}
    {%- endif -%}
{%- endmacro %}
{% from _self import carry %}
{% set overridden = 'This is being overridden by config/sorts.php.'|t('sorts') %}
{% set proNote = 'Needs Sorts Pro.'|t('sorts') %}

{# A Pro setting is locked on Lite, and any setting is locked when config/sorts.php overrides it.
   (Not a macro: a macro hands back a Markup object, and an empty one is still truthy.) #}

<h2>{{ 'General'|t('sorts') }}</h2>

{{ forms.textField({
    label: 'Plugin name'|t('sorts'),
    instructions: 'What this plugin is called in the control panel (sidebar, Plugins screen, settings). Leave blank for “Sorts”. Best set in config/sorts.php so it holds with admin changes off.'|t('sorts'),
    id: 'pluginName',
    name: 'pluginName',
    placeholder: 'Sorts',
    value: settings.pluginName,
    disabled: 'pluginName' in overrides,
    warning: 'pluginName' in overrides ? overridden,
}) }}
{% if 'pluginName' in overrides %}{{ carry('pluginName', stored.pluginName ?? null) }}{% endif %}

<hr>
<h2>{{ 'CKEditor'|t('sorts') }}</h2>

{% if ckeditorInstalled %}
    {{ forms.lightswitchField({
        label: 'Convert quotes as people type'|t('sorts'),
        instructions: 'Loads CKEditor’s text transformation plugin in every CKEditor field, set to the quotation marks of the site’s language where CKEditor can do that, and to the dashes, ellipsis and symbols Sorts sets. It acts on typing only: pasted text and saved content are left to the page pass and fix-on-save. A field’s own CKEditor config can switch it off.'|t('sorts'),
        id: 'ckeditorAsYouType',
        name: 'ckeditorAsYouType',
        on: settings.ckeditorAsYouType,
        disabled: 'ckeditorAsYouType' in overrides,
        warning: 'ckeditorAsYouType' in overrides ? overridden,
    }) }}
    {% if 'ckeditorAsYouType' in overrides %}{{ carry('ckeditorAsYouType', stored.ckeditorAsYouType ?? null) }}{% endif %}
{% else %}
    <p class="light">{{ 'CKEditor is not installed, so there is nothing to set here.'|t('sorts') }}</p>
    {{ carry('ckeditorAsYouType', stored.ckeditorAsYouType ?? null) }}
{% endif %}

{% if not isPro %}
    <hr>
    <p class="warning with-icon">{{ 'The settings below need Sorts Pro. They are shown so you can see what Pro does, and cannot be changed on Lite.'|t('sorts') }}</p>
{% endif %}

<hr>
<h2>{{ 'Page pass'|t('sorts') }} <span class="code">Pro</span></h2>

{% set lockPagePass = ('pagePass' in overrides) or not isPro %}
{{ forms.lightswitchField({
    label: 'Fix the typography of every page'|t('sorts'),
    instructions: 'Runs over each rendered page on the front end, with no template edits. Never runs for the control panel, console or action requests, or a response that is not HTML.'|t('sorts'),
    id: 'pagePass',
    name: 'pagePass',
    on: settings.pagePass,
    disabled: lockPagePass,
    warning: 'pagePass' in overrides ? overridden : (not isPro ? proNote),
}) }}
{% if lockPagePass %}{{ carry('pagePass', stored.pagePass ?? null) }}{% endif %}

{% set lockProcessHead = ('processHead' in overrides) or not isPro %}
{{ forms.lightswitchField({
    label: 'Also fix the page title and meta descriptions'|t('sorts'),
    instructions: 'Off by default. Sets the text of <title> and the description, Open Graph and Twitter titles and descriptions in the head, which show in browser tabs and link previews.'|t('sorts'),
    id: 'processHead',
    name: 'processHead',
    on: settings.processHead,
    disabled: lockProcessHead,
    warning: 'processHead' in overrides ? overridden : (not isPro ? proNote),
}) }}
{% if lockProcessHead %}{{ carry('processHead', stored.processHead ?? null) }}{% endif %}

{% set lockMaxPage = ('maxPageBytes' in overrides) or not isPro %}
{{ forms.textField({
    label: 'Largest page to fix, in bytes'|t('sorts'),
    instructions: 'A larger page is sent as rendered, with a warning in the log. So is a page the pass might not have the memory for under PHP’s memory_limit.'|t('sorts'),
    id: 'maxPageBytes',
    name: 'maxPageBytes',
    type: 'number',
    size: 10,
    min: 1,
    value: settings.maxPageBytes,
    disabled: lockMaxPage,
    warning: 'maxPageBytes' in overrides ? overridden : (not isPro ? proNote),
}) }}
{% if lockMaxPage %}{{ carry('maxPageBytes', stored.maxPageBytes ?? null) }}{% endif %}

<hr>
<h2>{{ 'Fine typography'|t('sorts') }} <span class="code">Pro</span></h2>

{% set lockFine = ('fineTypography' in overrides) or not isPro %}
{{ forms.lightswitchField({
    label: 'Fine typography (Bringhurst)'|t('sorts'),
    instructions: 'After Robert Bringhurst, The Elements of Typographic Style, 3rd ed., chapter 5. Off by default. On: a spaced en dash for breaks in American English, also for typed em dashes (5.2.1); an em dash and a thin space to open dialogue (5.2.3); number ranges, including clock times (5.2.2); fractions joined to their whole number (5.2.5); the multiplication sign (5.2.6); a word space either side of an ellipsis in English (5.2.7); thin spaces inside guillemets, except in German (5.4.1). A rule you set to on or off below still wins (off keeps one of these rules off), and a quotation style you choose for a language wins over this. Applies to the page pass, the filter, fix on save and the audit.'|t('sorts'),
    id: 'fineTypography',
    name: 'fineTypography',
    on: settings.fineTypography,
    disabled: lockFine,
    warning: 'fineTypography' in overrides ? overridden : (not isPro ? proNote),
}) }}
{% if lockFine %}{{ carry('fineTypography', stored.fineTypography ?? null) }}{% endif %}

<hr>
<h2>{{ 'Rules'|t('sorts') }} <span class="code">Pro</span></h2>

{% set lockRules = ('rules' in overrides) or not isPro %}
{% set ruleLabels = {
    'quotes': 'Quotation marks',
    'apostrophes': 'Apostrophes, including leading ones',
    'primes': 'Primes for feet, inches, minutes and seconds',
    'dashes': 'Em and en dashes',
    'typed-dashes': 'Typed em dashes take the language’s break dash',
    'dialogue-dash': 'Dialogue dash: -- or — opening a block',
    'ellipsis': 'Ellipsis',
    'ellipsis-spacing': 'Word spaces round an ellipsis (English)',
    'symbols': 'Symbols: (c) (r) (tm)',
    'ranges': 'Number ranges (1-5 to 1–5)',
    'multiplication': 'Multiplication signs (3x4 to 3×4)',
    'fractions': 'Fractions (1/2 to ½)',
    'ordinals': 'Ordinals (1st with a superscript)',
    'widows': 'Widows: join the last two words of headings',
    'nbsp': 'No-break spaces: units, initials, honorifics',
    'locale-spacing': 'Locale spacing, such as French punctuation',
    'hook-amp': 'Wrap & in a span with class amp',
    'hook-caps': 'Wrap runs of capitals in a span with class caps',
    'hook-quotes': 'Wrap opening quotes in a span for hanging punctuation',
} %}
<p class="light">{{ 'Each rule is on, off, or follows the preset. Following is the default: the rule does what Fine typography says, and with that setting off, what the note beside it gives. Off keeps a rule off even when Fine typography turns it on; on turns on a rule that Fine typography leaves off. A rule that is off here still runs inside an element marked data-sorts-rules.'|t('sorts') }}</p>
{% for handle, label in ruleLabels %}
    {% set byDefault = (ruleDefaults[handle] ?? false) ? 'on'|t('sorts') : 'off'|t('sorts') %}
    {% set presetTurnsOn = (presetRules[handle] ?? false) and not (ruleDefaults[handle] ?? false) %}
    {{ forms.selectField({
        label: label|t('sorts'),
        instructions: (presetTurnsOn ? 'Default: {state}. Fine typography turns it on.' : 'Default: {state}.')|t('sorts', { state: byDefault }),
        id: 'rules-' ~ handle,
        name: 'rules[' ~ handle ~ ']',
        value: settings.ruleState(handle),
        options: [
            { label: 'Follow the preset'|t('sorts'), value: 'follow' },
            { label: 'On'|t('sorts'), value: 'on' },
            { label: 'Off'|t('sorts'), value: 'off' },
        ],
        disabled: lockRules,
    }) }}
{% endfor %}
{% if lockRules %}
    <p class="light">{{ 'rules' in overrides ? overridden : proNote }}</p>
    {{ carry('rules', stored.rules ?? null) }}
{% endif %}

{% set lockWidows = ('widowsMinWords' in overrides) or not isPro %}
{{ forms.textField({
    label: 'Fewest words in a heading before widows are joined'|t('sorts'),
    id: 'widowsMinWords',
    name: 'widowsMinWords',
    type: 'number',
    size: 3,
    min: 2,
    max: 20,
    value: settings.widowsMinWords,
    disabled: lockWidows,
    warning: 'widowsMinWords' in overrides ? overridden : (not isPro ? proNote),
}) }}
{% if lockWidows %}{{ carry('widowsMinWords', stored.widowsMinWords ?? null) }}{% endif %}

<hr>
<h2>{{ 'Quotation styles'|t('sorts') }} <span class="code">Pro</span></h2>
<p class="light">{{ 'Sorts follows Unicode CLDR for each language. Where a style authority writes it differently, you can choose that convention here.'|t('sorts') }}</p>

{% set lockNormalize = ('normalizeQuotes' in overrides) or not isPro %}
{{ forms.lightswitchField({
    label: 'Normalize quotes to house style'|t('sorts'),
    instructions: 'Off by default: an outermost quotation typed with a straight " gets the language’s main pair and one typed with a straight \' its inner pair, as in CKEditor while typing, and a quotation inside another gets the other pair. On: every quotation is set by its depth instead, the main pair outermost and the inner pair inside it, whichever mark was typed. Applies to the page pass, the filter, fix on save and the audit.'|t('sorts'),
    id: 'normalizeQuotes',
    name: 'normalizeQuotes',
    on: settings.normalizeQuotes,
    disabled: lockNormalize,
    warning: 'normalizeQuotes' in overrides ? overridden : (not isPro ? proNote),
}) }}
{% if lockNormalize %}{{ carry('normalizeQuotes', stored.normalizeQuotes ?? null) }}{% endif %}

{% set lockVariants = ('variants' in overrides) or not isPro %}
{% for id, names in variants %}
    {{ forms.selectField({
        label: id,
        id: 'variants-' ~ id,
        name: 'variants[' ~ id ~ ']',
        value: settings.variants[id] ?? '',
        options: [{ label: 'CLDR default'|t('sorts'), value: '' }]|merge(names|map(n => { label: n, value: n })),
        disabled: lockVariants,
    }) }}
{% endfor %}
{% if lockVariants %}
    <p class="light">{{ 'variants' in overrides ? overridden : proNote }}</p>
    {{ carry('variants', stored.variants ?? null) }}
{% endif %}

<hr>
<h2>{{ 'Exclusions'|t('sorts') }} <span class="code">Pro</span></h2>
<p class="light">{{ 'Any element can also opt out in the template with data-sorts="off", set its language with data-sorts-lang, or turn on a rule with data-sorts-rules.'|t('sorts') }}</p>

{% for name, spec in {
    skipTags: ['Tags to skip', 'HTML tag names, one per line, such as figcaption. Everything inside is left alone, as it already is for pre, code, kbd, samp, var, textarea, math, svg, template, noscript, script and style.'],
    skipClasses: ['Classes to skip', 'Class names, one per line, such as no-typography. An element with one of them, and everything inside it, is left alone.'],
    skipUris: ['Paths to skip', 'Request paths, one per line, such as /api/* or /sitemap.xml. An asterisk matches any run of characters. Matched against the path as requested, including a site’s own prefix.'],
} %}
    {% set lock = (name in overrides) or not isPro %}
    {{ forms.textareaField({
        label: spec[0]|t('sorts'),
        instructions: spec[1]|t('sorts'),
        id: name,
        name: name,
        rows: 4,
        class: 'code',
        value: attribute(settings, name)|join("\n"),
        errors: settings.getErrors(name),
        disabled: lock,
        warning: name in overrides ? overridden : (not isPro ? proNote),
    }) }}
    {% if lock %}{{ carry(name, stored[name] ?? null) }}{% endif %}
{% endfor %}

<hr>
<h2>{{ 'Fix on save'|t('sorts') }} <span class="code">Pro</span></h2>
<p class="light">{{ 'Changes the characters in stored content as an element is saved, so feeds, APIs and search see them too. It sets quotes, apostrophes, primes, dashes, ellipsis, symbols and, if they are switched on, fractions, ranges and multiplication signs; never spacing or markup. Never touches slugs, URIs, handles, URLs, email addresses or code fields. Skips autosaved drafts, revisions and propagation to other sites. A value that reaches a site in another language as it is saved (any value of a new entry, or a field shared by every site) is left as typed: the page pass sets it on each page in that page’s language. The audit utility (Utilities → Sorts) fixes what is already saved, by the same rule.'|t('sorts') }}</p>

{% for name, label in {
    fixOnSave: 'Fix content when an element is saved',
    fixTitles: 'Element titles',
    fixPlainText: 'Plain Text fields (not set to code)',
    fixCkeditor: 'CKEditor fields',
    fixOnSaveBulk: 'Also fix when resaving and while migrations run',
} %}
    {% set lock = (name in overrides) or not isPro %}
    {{ forms.lightswitchField({
        label: label|t('sorts'),
        instructions: name == 'fixTitles' ? 'Fix-on-save and the audit both use the choices from here to the next heading.'|t('sorts') : null,
        id: name,
        name: name,
        on: attribute(settings, name),
        disabled: lock,
        warning: name in overrides ? overridden : (not isPro ? proNote),
    }) }}
    {% if lock %}{{ carry(name, stored[name] ?? null) }}{% endif %}
{% endfor %}
